.page.data-v-ecc172b4 {
  min-height: 100vh;
  background: #FAFBFD;
  display: flex;
  flex-direction: column;
}
.page--dark.data-v-ecc172b4 {
  background: #0D1117;
}
.status-bar.data-v-ecc172b4 {
  flex-shrink: 0;
}
.navbar.data-v-ecc172b4 {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  flex-shrink: 0;
}
.navbar__title.data-v-ecc172b4 {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2B3C;
}
.tabs.data-v-ecc172b4 {
  display: flex;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F0F2F5;
  flex-shrink: 0;
}
.tab-item.data-v-ecc172b4 {
  position: relative;
  padding: 16rpx 32rpx;
  margin-right: 32rpx;
}
.tab-item__text.data-v-ecc172b4 {
  font-size: 28rpx;
  color: #5A6B7C;
  transition: color 0.25s ease;
}
.tab-item--active .tab-item__text.data-v-ecc172b4 {
  color: #1E3A5F;
  font-weight: 600;
}
.tab-item__indicator.data-v-ecc172b4 {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #1E3A5F;
  border-radius: 3rpx;
}
.content.data-v-ecc172b4 {
  flex: 1;
  overflow: hidden;
}
.empty.data-v-ecc172b4 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx;
}
.empty__icon.data-v-ecc172b4 {
  width: 120rpx;
  height: 120rpx;
  background: #F0F5FA;
  border-radius: 50%;
  margin-bottom: 32rpx;
  position: relative;
}
.empty__icon.data-v-ecc172b4::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 48rpx;
  border: 4rpx solid #9AABBF;
  border-radius: 8rpx;
}
.empty__text.data-v-ecc172b4 {
  font-size: 28rpx;
  color: #9AABBF;
}
.messages.data-v-ecc172b4 {
  padding: 24rpx 32rpx;
}
.message-item.data-v-ecc172b4 {
  display: flex;
  align-items: flex-start;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(30, 58, 95, 0.06);
  margin-bottom: 24rpx;
  position: relative;
}
.message-item__avatar.data-v-ecc172b4 {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.message-item__avatar--system.data-v-ecc172b4 {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(59, 130, 246, 0.2) 100%);
}
.message-item__avatar--consult.data-v-ecc172b4 {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(240, 147, 251, 0.1) 100%);
}
.message-item__avatar--notify.data-v-ecc172b4 {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(245, 158, 11, 0.2) 100%);
}
.message-item__content.data-v-ecc172b4 {
  flex: 1;
  min-width: 0;
}
.message-item__header.data-v-ecc172b4 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.message-item__title.data-v-ecc172b4 {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A2B3C;
}
.message-item__time.data-v-ecc172b4 {
  font-size: 22rpx;
  color: #9AABBF;
  flex-shrink: 0;
}
.message-item__desc.data-v-ecc172b4 {
  font-size: 24rpx;
  color: #5A6B7C;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.message-item__badge.data-v-ecc172b4 {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 16rpx;
  height: 16rpx;
  background: #FF6B5B;
  border-radius: 50%;
}
.avatar-icon.data-v-ecc172b4 {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}
.avatar-icon--system.data-v-ecc172b4 {
  border: 3rpx solid #3B82F6;
  border-radius: 50%;
}
.avatar-icon--system.data-v-ecc172b4::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 4rpx;
  height: 16rpx;
  background: #3B82F6;
}
.avatar-icon--system.data-v-ecc172b4::after {
  content: "";
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 4rpx;
  background: #3B82F6;
  border-radius: 50%;
}
.avatar-icon--consult.data-v-ecc172b4::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 40rpx;
  background: linear-gradient(180deg, #667EEA 0%, #F093FB 100%);
  border-radius: 4rpx;
}
.avatar-icon--consult.data-v-ecc172b4::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
  width: 40rpx;
  height: 8rpx;
  background: linear-gradient(90deg, #667EEA 0%, #F093FB 100%);
  border-radius: 4rpx;
}
.avatar-icon--notify.data-v-ecc172b4 {
  border: 3rpx solid #F59E0B;
  border-radius: 20rpx 20rpx 6rpx 6rpx;
  height: 36rpx;
}
.avatar-icon--notify.data-v-ecc172b4::after {
  content: "";
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 6rpx;
  background: #F59E0B;
  border-radius: 0 0 6rpx 6rpx;
}
.tabbar-placeholder.data-v-ecc172b4 {
  height: calc(140rpx + env(safe-area-inset-bottom));
}
.page--dark .navbar__title.data-v-ecc172b4 {
  color: #F0F6FC;
}
.page--dark .tabs.data-v-ecc172b4 {
  border-bottom-color: #30363D;
}
.page--dark .tab-item__text.data-v-ecc172b4 {
  color: #8B949E;
}
.page--dark .tab-item--active .tab-item__text.data-v-ecc172b4 {
  color: #4A90D9;
}
.page--dark .tab-item__indicator.data-v-ecc172b4 {
  background: #4A90D9;
}
.page--dark .empty__icon.data-v-ecc172b4 {
