}
.page--dark .empty__icon.data-v-ecc172b4::before {
  border-color: #484F58;
}
.page--dark .empty__text.data-v-ecc172b4 {
  color: #484F58;
}
.page--dark .message-item.data-v-ecc172b4 {
  background: #161B22;
}
.page--dark .message-item__title.data-v-ecc172b4 {
  color: #F0F6FC;
}
.page--dark .message-item__time.data-v-ecc172b4 {
  color: #484F58;
}
.page--dark .message-item__desc.data-v-ecc172b4 {
  color: #8B949E;
}