.page.data-v-ef2dfbea {
  min-height: 100vh;
  background: #FAFBFD;
  display: flex;
  flex-direction: column;
}
.page--dark.data-v-ef2dfbea {
  background: #0D1117;
}
.status-bar.data-v-ef2dfbea {
  flex-shrink: 0;
}
.navbar.data-v-ef2dfbea {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  flex-shrink: 0;
}
.navbar__title.data-v-ef2dfbea {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2B3C;
}
.departments.data-v-ef2dfbea {
  white-space: nowrap;
  padding: 24rpx 32rpx;
  flex-shrink: 0;
}
.department-tag.data-v-ef2dfbea {
  display: inline-block;
  padding: 16rpx 32rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E9EF;
  border-radius: 9999rpx;
  margin-right: 24rpx;
  font-size: 24rpx;
  color: #5A6B7C;
  transition: all 0.25s ease;
}
.department-tag--active.data-v-ef2dfbea {
  background: #1E3A5F;
  border-color: #1E3A5F;
  color: #fff;
}
.department-tag.data-v-ef2dfbea:active {
  transform: scale(0.95);
}
.content.data-v-ef2dfbea {
  flex: 1;
  overflow: hidden;
}
.doctors.data-v-ef2dfbea {
  padding: 24rpx 32rpx;
}
.doctor-card.data-v-ef2dfbea {
  display: flex;
  align-items: flex-start;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(30, 58, 95, 0.06);
  margin-bottom: 24rpx;
}
.doctor-card__avatar.data-v-ef2dfbea {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #2D5A87 0%, #1E3A5F 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.doctor-card__avatar-text.data-v-ef2dfbea {
  font-size: 40rpx;
  color: #fff;
  font-weight: 700;
}
.doctor-card__info.data-v-ef2dfbea {
  flex: 1;
  margin: 0 24rpx;
}
.doctor-card__header.data-v-ef2dfbea {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.doctor-card__name.data-v-ef2dfbea {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2B3C;
  margin-right: 16rpx;
}
.doctor-card__title.data-v-ef2dfbea {
  font-size: 22rpx;
  color: #1E3A5F;
  background: rgba(30, 58, 95, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.doctor-card__dept.data-v-ef2dfbea {
  font-size: 24rpx;
  color: #5A6B7C;
  margin-bottom: 8rpx;
  display: block;
}
.doctor-card__intro.data-v-ef2dfbea {
  font-size: 24rpx;
  color: #9AABBF;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.doctor-card__footer.data-v-ef2dfbea {
  display: flex;
  align-items: center;
}
.doctor-card__rating.data-v-ef2dfbea {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
}
.doctor-card__rating-value.data-v-ef2dfbea {
  font-size: 24rpx;
  color: #F59E0B;
  font-weight: 600;
}
.doctor-card__count.data-v-ef2dfbea {
  font-size: 22rpx;
  color: #9AABBF;
}
.doctor-card__action.data-v-ef2dfbea {
  flex-shrink: 0;
}
.doctor-card__btn.data-v-ef2dfbea {
  padding: 16rpx 32rpx;
  background: #1E3A5F;
  color: #fff;
  font-size: 24rpx;
  border-radius: 16rpx;
  font-weight: 500;
}
.doctor-card__btn--disabled.data-v-ef2dfbea {
  background: #9AABBF;
}
.doctor-card__btn.data-v-ef2dfbea:active {
  opacity: 0.8;
}
.star-icon.data-v-ef2dfbea {
  width: 24rpx;
  height: 24rpx;
  position: relative;
  margin-right: 4rpx;
}
.star-icon.data-v-ef2dfbea::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 8rpx solid #F59E0B;
}
.star-icon.data-v-ef2dfbea::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 16rpx solid #F59E0B;
}
.tabbar-placeholder.data-v-ef2dfbea {
  height: calc(140rpx + env(safe-area-inset-bottom));
}
.page--dark .navbar__title.data-v-ef2dfbea {
  color: #F0F6FC;
}
.page--dark .department-tag.data-v-ef2dfbea {
  background: #161B22;
  border-color: #30363D;
  color: #8B949E;
}
.page--dark .department-tag--active.data-v-ef2dfbea {
  background: #4A90D9;
  border-color: #4A90D9;
  color: #fff;
}
.page--dark .doctor-card.data-v-ef2dfbea {
  background: #161B22;
}
.page--dark .doctor-card__name.data-v-ef2dfbea {
  color: #F0F6FC;
}
.page--dark .doctor-card__title.data-v-ef2dfbea {
  color: #4A90D9;
  background: rgba(74, 144, 217, 0.15);
}
.page--dark .doctor-card__dept.data-v-ef2dfbea {
  color: #8B949E;
}
.page--dark .doctor-card__intro.data-v-ef2dfbea {
  color: #484F58;
}
.page--dark .doctor-card__count.data-v-ef2dfbea {
  color: #484F58;
}
.page--dark .doctor-card__btn.data-v-ef2dfbea {
  background: #4A90D9;
}
.page--dark .doctor-card__btn--disabled.data-v-ef2dfbea {
  background: #484F58;
}