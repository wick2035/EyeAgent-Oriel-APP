.page.data-v-78fd8d65 {
  min-height: 100vh;
  background: #FAFBFD;
  display: flex;
  flex-direction: column;
}
.page--dark.data-v-78fd8d65 {
  background: #0D1117;
}
.status-bar.data-v-78fd8d65 {
  flex-shrink: 0;
}
.navbar.data-v-78fd8d65 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
  flex-shrink: 0;
}
.navbar__left.data-v-78fd8d65, .navbar__right.data-v-78fd8d65 {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.navbar__title.data-v-78fd8d65 {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2B3C;
}
.back-icon.data-v-78fd8d65 {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #1A2B3C;
  border-bottom: 4rpx solid #1A2B3C;
  transform: rotate(45deg);
}
.history-icon.data-v-78fd8d65 {
  width: 40rpx;
  height: 36rpx;
  border: 3rpx solid #5A6B7C;
  border-radius: 6rpx;
  position: relative;
}
.history-icon.data-v-78fd8d65::before {
  content: "";
  position: absolute;
  top: 8rpx;
  left: 6rpx;
  right: 6rpx;
  height: 3rpx;
  background: #5A6B7C;
}
.history-icon.data-v-78fd8d65::after {
  content: "";
  position: absolute;
  top: 18rpx;
  left: 6rpx;
  width: 60%;
  height: 3rpx;
  background: #5A6B7C;
}
.content.data-v-78fd8d65 {
  flex: 1;
  overflow: hidden;
}
.content__bottom-space.data-v-78fd8d65 {
  height: calc(200rpx + env(safe-area-inset-bottom));
}
.welcome.data-v-78fd8d65 {
  padding: 48rpx 32rpx;
}
.welcome__header.data-v-78fd8d65 {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}
.welcome__avatar.data-v-78fd8d65 {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(240, 147, 251, 0.1) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.welcome__hi.data-v-78fd8d65 {
  background: #1A2B3C;
  color: #fff;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.welcome__title.data-v-78fd8d65 {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1A2B3C;
  margin-bottom: 16rpx;
}
.welcome__subtitle.data-v-78fd8d65 {
  display: block;
  font-size: 28rpx;
  color: #5A6B7C;
  margin-bottom: 48rpx;
}
.ai-icon-large.data-v-78fd8d65 {
  width: 56rpx;
  height: 56rpx;
  position: relative;
  animation: ai-rotate-78fd8d65 8s linear infinite;
}
.ai-petal.data-v-78fd8d65 {
  position: absolute;
  width: 14rpx;
  height: 22rpx;
  border-radius: 7rpx;
  top: 50%;
  left: 50%;
  transform-origin: center 18rpx;
  margin-left: -7rpx;
  margin-top: -18rpx;
}
.ai-petal--1.data-v-78fd8d65 {
  background: #FF6B6B;
  transform: rotate(0deg);
}
.ai-petal--2.data-v-78fd8d65 {
  background: #4ECDC4;
  transform: rotate(72deg);
}
.ai-petal--3.data-v-78fd8d65 {
  background: #45B7D1;
  transform: rotate(144deg);
}
.ai-petal--4.data-v-78fd8d65 {
  background: #96CEB4;
  transform: rotate(216deg);
}
.ai-petal--5.data-v-78fd8d65 {
  background: #DDA0DD;
  transform: rotate(288deg);
}
.quick-actions.data-v-78fd8d65 {
  white-space: nowrap;
  margin-bottom: 48rpx;
}
.quick-action.data-v-78fd8d65 {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E9EF;
  border-radius: 9999rpx;
  margin-right: 24rpx;
  transition: all 0.25s ease;
}
.quick-action.data-v-78fd8d65:active {
  transform: scale(0.95);
  background: #F0F5FA;
}
.quick-action__icon.data-v-78fd8d65 {
  font-size: 32rpx;
  margin-right: 8rpx;
}
.quick-action__text.data-v-78fd8d65 {
  font-size: 24rpx;
  color: #1A2B3C;
  font-weight: 500;
}
.prompts__header.data-v-78fd8d65 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.prompts__title.data-v-78fd8d65 {
  font-size: 28rpx;
  color: #5A6B7C;
}
.prompts__refresh.data-v-78fd8d65 {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
}
.prompts__refresh-text.data-v-78fd8d65 {
  font-size: 24rpx;
  color: #1E3A5F;
  margin-left: 8rpx;
}
.refresh-icon.data-v-78fd8d65 {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #1E3A5F;
  border-radius: 50%;
  border-right-color: transparent;
  animation: none;
}
.prompts__refresh:active .refresh-icon.data-v-78fd8d65 {
  animation: refresh-spin-78fd8d65 0.5s ease;
}
.messages.data-v-78fd8d65 {
  padding: 24rpx 0;
}
.page--dark .navbar__title.data-v-78fd8d65 {
  color: #F0F6FC;
}
.page--dark .back-icon.data-v-78fd8d65 {
  border-color: #F0F6FC;
}
.page--dark .history-icon.data-v-78fd8d65 {
  border-color: #8B949E;
}
.page--dark .history-icon.data-v-78fd8d65::before, .page--dark .history-icon.data-v-78fd8d65::after {
  background: #8B949E;
}
.page--dark .welcome__hi.data-v-78fd8d65 {
  background: #F0F6FC;
}
.page--dark .welcome__title.data-v-78fd8d65 {
  color: #F0F6FC;
}
.page--dark .welcome__subtitle.data-v-78fd8d65 {
  color: #8B949E;
}
.page--dark .quick-action.data-v-78fd8d65 {
  background: #161B22;
  border-color: #30363D;
}
.page--dark .quick-action__text.data-v-78fd8d65 {
  color: #F0F6FC;
}
.page--dark .prompts__title.data-v-78fd8d65 {
  color: #8B949E;
}
.page--dark .prompts__refresh-text.data-v-78fd8d65 {
  color: #4A90D9;
}
.page--dark .refresh-icon.data-v-78fd8d65 {
  border-color: #4A90D9;
  border-right-color: transparent;
}
@keyframes ai-rotate-78fd8d65 {
from {
    transform: rotate(0deg);
}
to {
    transform: rotate(360deg);
}
}
@keyframes refresh-spin-78fd8d65 {
from {
    transform: rotate(0deg);
}
to {
    transform: rotate(360deg);
}
}