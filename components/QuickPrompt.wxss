.prompt-card.data-v-1fafe24b {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E9EF;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  transition: all 0.25s ease;
}
.prompt-card.data-v-1fafe24b:active {
  transform: scale(0.98);
  background: #F0F5FA;
}
.prompt-card__tag.data-v-1fafe24b {
  width: 44rpx;
  height: 44rpx;
  background: rgba(30, 58, 95, 0.08);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1E3A5F;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.prompt-card__text.data-v-1fafe24b {
  flex: 1;
  font-size: 28rpx;
  color: #1A2B3C;
  line-height: 1.5;
}
.prompt-card__arrow.data-v-1fafe24b {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #9AABBF;
  border-right: 3rpx solid #9AABBF;
  transform: rotate(45deg);
  margin-left: 24rpx;
  flex-shrink: 0;
}
.prompt-card--dark.data-v-1fafe24b {
  background: #161B22;
  border-color: #30363D;
}
.prompt-card--dark.data-v-1fafe24b:active {
  background: #21262D;
}
.prompt-card--dark .prompt-card__tag.data-v-1fafe24b {
  background: rgba(74, 144, 217, 0.15);
  color: #4A90D9;
}
.prompt-card--dark .prompt-card__text.data-v-1fafe24b {
  color: #F0F6FC;
}
.prompt-card--dark .prompt-card__arrow.data-v-1fafe24b {
  border-color: #484F58;
}