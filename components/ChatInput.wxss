.chat-input.data-v-01e239dc {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 100;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}
.chat-input__wrapper.data-v-01e239dc {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  margin: 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(30, 58, 95, 0.08);
}
.chat-input__ai-icon.data-v-01e239dc {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.chat-input__field.data-v-01e239dc {
  flex: 1;
  height: 56rpx;
  font-size: 28rpx;
  color: #1A2B3C;
  background: transparent;
}
.chat-input__actions.data-v-01e239dc {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-left: 16rpx;
}
.chat-input__btn.data-v-01e239dc {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}
.chat-input__btn--voice.data-v-01e239dc {
  background: #F0F5FA;
}
.chat-input__btn--voice.data-v-01e239dc:active {
  transform: scale(0.9);
}
.chat-input__btn--send.data-v-01e239dc {
  background: #F0F5FA;
}
.chat-input__btn--send.chat-input__btn--active.data-v-01e239dc {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 50%, #F093FB 100%);
}
.chat-input__btn--send.chat-input__btn--active .send-icon.data-v-01e239dc {
  border-color: #fff;
}
.chat-input__btn--send.data-v-01e239dc:active {
  transform: scale(0.9);
}
.chat-input--dark.data-v-01e239dc {
  background: rgba(22, 27, 34, 0.95);
  border-top-color: #21262D;
}
.chat-input--dark .chat-input__wrapper.data-v-01e239dc {
  background: #161B22;
}
.chat-input--dark .chat-input__field.data-v-01e239dc {
  color: #F0F6FC;
}
.chat-input--dark .chat-input__btn--voice.data-v-01e239dc {
  background: #21262D;
}
.chat-input--dark .chat-input__btn--send.data-v-01e239dc {
  background: #21262D;
}
.chat-input--dark .chat-input__btn--send.chat-input__btn--active.data-v-01e239dc {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 50%, #F093FB 100%);
}
.chat-input--dark .voice-icon.data-v-01e239dc {
  background: #484F58;
}
.chat-input--dark .voice-icon.data-v-01e239dc::before, .chat-input--dark .voice-icon.data-v-01e239dc::after {
  border-color: #484F58;
}
.chat-input--dark .send-icon.data-v-01e239dc {
  border-color: #484F58;
}
.ai-sparkle.data-v-01e239dc {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}
.ai-sparkle.data-v-01e239dc::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #667EEA 0%, #F093FB 100%);
  border-radius: 4rpx;
}
.ai-sparkle.data-v-01e239dc::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
  width: 32rpx;
  height: 8rpx;
  background: linear-gradient(90deg, #667EEA 0%, #F093FB 100%);
  border-radius: 4rpx;
}
.voice-icon.data-v-01e239dc {
  width: 20rpx;
  height: 28rpx;
  background: #9AABBF;
  border-radius: 10rpx 10rpx 10rpx 10rpx;
  position: relative;
}
.voice-icon.data-v-01e239dc::before {
  content: "";
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 14rpx;
  border: 3rpx solid #9AABBF;
  border-top: none;
  border-radius: 0 0 14rpx 14rpx;
}
.voice-icon.data-v-01e239dc::after {
  content: "";
  position: absolute;
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 3rpx;
  height: 8rpx;
  background: #9AABBF;
}
.send-icon.data-v-01e239dc {
  width: 0;
  height: 0;
  border: 12rpx solid transparent;
  border-left: 16rpx solid #9AABBF;
  margin-left: 6rpx;
}