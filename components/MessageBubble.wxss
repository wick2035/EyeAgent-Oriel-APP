.message.data-v-537f4398 {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 32rpx;
  animation: messageIn-537f4398 0.3s ease;
}
.message--user.data-v-537f4398 {
  justify-content: flex-end;
}
.message--user .message__content.data-v-537f4398 {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.message--user .message__bubble.data-v-537f4398 {
  background: #1E3A5F;
  color: #fff;
  border-radius: 24rpx 24rpx 8rpx 24rpx;
}
.message--user .message__text.data-v-537f4398 {
  color: #fff;
}
.message--user .message__time.data-v-537f4398 {
  text-align: right;
}
.message--user .message__avatar.data-v-537f4398 {
  margin-left: 24rpx;
  margin-right: 0;
  order: 1;
}
.message--ai .message__bubble.data-v-537f4398 {
  background: #FFFFFF;
  border: 1rpx solid #F0F2F5;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
}
.message__avatar.data-v-537f4398 {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.message__avatar--user.data-v-537f4398 {
  background: #2D5A87;
}
.message__content.data-v-537f4398 {
  max-width: calc(100% - 160rpx);
}
.message__bubble.data-v-537f4398 {
  display: inline-block;
  padding: 24rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(30, 58, 95, 0.06);
  max-width: 100%;
}
.message__text.data-v-537f4398 {
  font-size: 28rpx;
  line-height: 1.75;
  word-break: break-word;
}
.message__time.data-v-537f4398 {
  font-size: 22rpx;
  color: #9AABBF;
  margin-top: 8rpx;
  display: block;
}
.message--dark.message--ai .message__bubble.data-v-537f4398 {
  background: #161B22;
  border-color: #30363D;
}
.message--dark.message--ai .message__text.data-v-537f4398 {
  color: #F0F6FC;
}
.message--dark.message--user .message__bubble.data-v-537f4398 {
  background: #4A90D9;
}
.message--dark.message--user .message__text.data-v-537f4398 {
  color: #fff;
}
.message--dark .message__time.data-v-537f4398 {
  color: #484F58;
}
.message--dark .message__avatar--user.data-v-537f4398 {
  background: #4A90D9;
}
.ai-avatar.data-v-537f4398 {
  width: 48rpx;
  height: 48rpx;
  position: relative;
  animation: ai-rotate-537f4398 6s linear infinite;
}
.ai-petal.data-v-537f4398 {
  position: absolute;
  width: 10rpx;
  height: 18rpx;
  border-radius: 5rpx;
  top: 50%;
  left: 50%;
  transform-origin: center 14rpx;
  margin-left: -5rpx;
  margin-top: -14rpx;
}
.ai-petal--1.data-v-537f4398 {
  background: #FF6B6B;
  transform: rotate(0deg);
}
.ai-petal--2.data-v-537f4398 {
  background: #4ECDC4;
  transform: rotate(72deg);
}
.ai-petal--3.data-v-537f4398 {
  background: #45B7D1;
  transform: rotate(144deg);
}
.ai-petal--4.data-v-537f4398 {
  background: #96CEB4;
  transform: rotate(216deg);
}
.ai-petal--5.data-v-537f4398 {
  background: #DDA0DD;
  transform: rotate(288deg);
}
.user-avatar.data-v-537f4398 {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}
.typing-indicator.data-v-537f4398 {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
}
.typing-dot.data-v-537f4398 {
  width: 12rpx;
  height: 12rpx;
  background: #9AABBF;
  border-radius: 50%;
  animation: typingBounce-537f4398 1.4s ease-in-out infinite;
}
.typing-dot.data-v-537f4398:nth-child(2) {
  animation-delay: 0.2s;
}
.typing-dot.data-v-537f4398:nth-child(3) {
  animation-delay: 0.4s;
}
@keyframes ai-rotate-537f4398 {
from {
    transform: rotate(0deg);
}
to {
    transform: rotate(360deg);
}
}
@keyframes messageIn-537f4398 {
from {
    opacity: 0;
    transform: translateY(20rpx);
}
to {
    opacity: 1;
    transform: translateY(0);
}
}
@keyframes typingBounce-537f4398 {
0%, 60%, 100% {
    transform: translateY(0);
}
30% {
    transform: translateY(-8rpx);
}
}