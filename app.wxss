/* AI医问通 - 全局公共样式 */
/* 重置默认样式 */
page {
  background-color: #FAFBFD;
  font-family: "PingFang SC", "Noto Sans SC", -apple-system, sans-serif;
  font-size: 28rpx;
  color: #1A2B3C;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
view, text {
  box-sizing: border-box;
}

/* 隐藏滚动条 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  background: transparent;
}

/* 输入框placeholder样式 */
.uni-input-placeholder,
.uni-textarea-placeholder {
  color: #9AABBF;
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 文字省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Flex布局工具类 */
.flex {
  display: flex;
}
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-col {
  display: flex;
  flex-direction: column;
}
.flex-1 {
  flex: 1;
}

/* 间距工具类 */
.mt-sm {
  margin-top: 16rpx;
}
.mt-md {
  margin-top: 24rpx;
}
.mt-lg {
  margin-top: 32rpx;
}
.mb-sm {
  margin-bottom: 16rpx;
}
.mb-md {
  margin-bottom: 24rpx;
}
.mb-lg {
  margin-bottom: 32rpx;
}
.ml-sm {
  margin-left: 16rpx;
}
.ml-md {
  margin-left: 24rpx;
}
.mr-sm {
  margin-right: 16rpx;
}
.mr-md {
  margin-right: 24rpx;
}
.pt-sm {
  padding-top: 16rpx;
}
.pt-md {
  padding-top: 24rpx;
}
.pb-sm {
  padding-bottom: 16rpx;
}
.pb-md {
  padding-bottom: 24rpx;
}
.px-md {
  padding-left: 24rpx;
  padding-right: 24rpx;
}
.py-md {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

/* 文字颜色 */
.text-primary {
  color: #1A2B3C;
}
.text-secondary {
  color: #5A6B7C;
}
.text-muted {
  color: #9AABBF;
}
.text-accent {
  color: #FF6B5B;
}

/* 背景颜色 */
.bg-base {
  background-color: #FAFBFD;
}
.bg-card {
  background-color: #FFFFFF;
}
.bg-primary {
  background-color: #1E3A5F;
}

/* 圆角 */
.rounded-sm {
  border-radius: 12rpx;
}
.rounded-md {
  border-radius: 16rpx;
}
.rounded-lg {
  border-radius: 24rpx;
}
.rounded-full {
  border-radius: 9999rpx;
}

/* 阴影 */
.shadow-sm {
  box-shadow: 0 2rpx 8rpx rgba(30, 58, 95, 0.06);
}
.shadow-md {
  box-shadow: 0 4rpx 16rpx rgba(30, 58, 95, 0.08);
}
.shadow-lg {
  box-shadow: 0 8rpx 32rpx rgba(30, 58, 95, 0.12);
}

/* 动画类 */
.fade-in {
  animation: fadeIn 0.3s ease;
}
.slide-up {
  animation: slideUp 0.3s ease;
}
@keyframes fadeIn {
from {
    opacity: 0;
}
to {
    opacity: 1;
}
}
@keyframes slideUp {
from {
    opacity: 0;
    transform: translateY(20rpx);
}
to {
    opacity: 1;
    transform: translateY(0);
}
}
/* 点击反馈 */
.clickable {
  transition: opacity 0.15s ease, transform 0.15s ease;
}
.clickable:active {
  opacity: 0.7;
  transform: scale(0.98);
}

/* 禁用状态 */
.disabled {
  opacity: 0.4;
  pointer-events: none;
